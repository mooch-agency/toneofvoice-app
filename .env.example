# Copy to .env.local and fill in. Never commit real values.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OpenAI (server only)
OPENAI_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: newer publishable key, used instead of the anon key when set
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe. STRIPE_MODE=test uses the STRIPE_TEST_* values.
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_AGENCY_PRICE_ID=
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_TEST_PRO_PRICE_ID=
STRIPE_TEST_AGENCY_PRICE_ID=

# Email (Resend)
RESEND_API_KEY=

# Vercel cron: shared secret for /api/cron/keep-alive
CRON_SECRET=

# Webflow blog publishing via /api/post-to-webflow (requires WEBFLOW_WEBHOOK_SECRET)
WEBFLOW_TOKEN=
WEBFLOW_SITE_ID=
WEBFLOW_COLLECTION_ID=
WEBFLOW_WEBHOOK_SECRET=

# Analytics
NEXT_PUBLIC_MIXPANEL_TOKEN=
# Comma-separated emails excluded from analytics
NEXT_PUBLIC_INTERNAL_EMAILS=

# LangSmith tracing (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# PDF export: local Chrome for development (optional)
PDF_USE_LOCAL_CHROME=
CHROME_EXECUTABLE_PATH=
